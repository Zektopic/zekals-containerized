# Optional. The basic UI needs no keys, camera, Python or cloud service.
HOST=127.0.0.1
PORT=3000
FRONTEND_PORT=8080
LANGUAGE=en
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Enable only when a tracker is running. Loopback is the native-development default.
TRACKER_URL=
TRACKER_HOST=127.0.0.1
WEBSOCKET_PORT=8765
TRACKER_TOKEN=
PERFORMANCE_PROFILE=low
CAMERA_INDEX=0
HARDWARE_MODE=cpu
INFERENCE_ENGINE=mediapipe
OPENVINO_DEVICE=CPU
GAZE_MODEL=models/face_landmarker.task
MODEL_SHA256=64184e229b263107bc2b804c6625db1341ff2bb731874b0bcc2fe6544e0bc9ff

# Optional neural speech. Download and review voices first; see docs/speech-and-languages.md.
PIPER_URL=
PIPER_VOICES={}
